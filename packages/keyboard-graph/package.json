{
  "name": "keyboard-graph",
  "version": "0.1.0",
  "description": "Your GitHub contribution graph as a grid of clickable mechanical keycaps, with tactile press animations and synthesised switch sounds. React component + Web Component.",
  "license": "MIT",
  "author": "Rishab Agarwal (https://x.com/Yrishavjs)",
  "homepage": "https://github.com/Rishabjs03/3d-git#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rishabjs03/3d-git.git",
    "directory": "packages/keyboard-graph"
  },
  "bugs": "https://github.com/Rishabjs03/3d-git/issues",
  "keywords": [
    "github",
    "contributions",
    "contribution-graph",
    "heatmap",
    "keyboard",
    "keycap",
    "mechanical-keyboard",
    "react",
    "web-component",
    "custom-element",
    "motion",
    "web-audio"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "./dist/keyboard-graph.iife.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/keyboard-graph.iife.js",
  "jsdelivr": "./dist/keyboard-graph.iife.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./iife": "./dist/keyboard-graph.iife.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.iife.config.ts && node scripts/build-types.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "motion": ">=11.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
